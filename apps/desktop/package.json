{
  "name": "desktop",
  "productName": "Sektor",
  "private": true,
  "version": "0.0.0",
  "description": "Sektor",
  "author": "André Luiz",
  "license": "AGPL-3.0-only",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
