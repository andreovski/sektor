  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@sektor/core": "workspace:*",
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-orm": "0.45.4",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
